{# Pastille ronde colorée avec icône, comme dans la maquette. #}
{% macro pill(icon, tone = 'teal', size = 'md') %}
    <span class="pill pill-{{ size }} tone-{{ tone }}">{{ _self.icon(icon, size == 'lg' ? 28 : (size == 'sm' ? 16 : 20)) }}</span>
{%- endmacro %}
