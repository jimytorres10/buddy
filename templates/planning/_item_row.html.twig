{% import '_icons.html.twig' as ui %}
<div class="item-row" data-form-collection-target="item">
    <div class="item-row-fields{{ item.category is defined ? ' has-category' }}">
        <div class="item-field item-field-label">
            {{ form_widget(item.label, {attr: {'aria-label': 'Libellé'}}) }}
            {{ form_errors(item.label) }}
        </div>
        <div class="item-field item-field-amount">
            {{ form_widget(item.amount, {attr: {'aria-label': 'Montant par mois'}}) }}
            {{ form_errors(item.amount) }}
        </div>
        {% if item.category is defined %}
            <div class="item-field item-field-category">
                {{ form_widget(item.category, {attr: {'aria-label': 'Catégorie'}}) }}
            </div>
        {% endif %}
        {% if item.startMonth is defined %}
            {% set has_period = item.startMonth.vars.value or item.endMonth.vars.value or not item.vars.valid %}
            {% set by_duration = item.duration.vars.value is not empty %}
            <details class="item-period"{{ has_period ? ' open' }}
                     data-controller="period"
                     data-period-mode-value="{{ by_duration ? 'duration' : 'dates' }}">
                <summary>{{ ui.icon('calendar', 16) }} Seulement sur une période</summary>
                <div class="period-switch" role="group" aria-label="Type de période">
                    <button type="button" class="period-switch-btn" data-period-target="modeBtn" data-mode="dates" data-action="period#select">Choisir les dates</button>
                    <button type="button" class="period-switch-btn" data-period-target="modeBtn" data-mode="duration" data-action="period#select">Nombre de mois</button>
                </div>
                <div class="item-period-fields">
                    <div class="item-field">
                        {{ form_label(item.startMonth) }}
                        {{ form_widget(item.startMonth, {attr: {'data-period-target': 'start', 'data-action': 'period#refresh'}}) }}
                        {{ form_errors(item.startMonth) }}
                    </div>
                    <div class="item-field" data-period-target="endField">
                        {{ form_label(item.endMonth) }}
                        {{ form_widget(item.endMonth, {attr: {'data-period-target': 'end'}}) }}
                        {{ form_errors(item.endMonth) }}
                    </div>
                    <div class="item-field" data-period-target="durationField" hidden>
                        {{ form_label(item.duration) }}
                        <div class="input-suffixed">
                            {{ form_widget(item.duration, {attr: {'data-period-target': 'duration', 'data-action': 'period#refresh'}}) }}
                            <span class="input-suffix">mois</span>
                        </div>
                        {{ form_errors(item.duration) }}
                    </div>
                </div>
                <p class="item-period-hint" data-period-target="hint">Laisse vide pour « tous les mois ». Ex. : rappel d'impôts de septembre à décembre.</p>
            </details>
        {% endif %}
    </div>
    <button type="button" class="icon-btn icon-btn-danger" data-action="form-collection#remove" aria-label="Retirer cette ligne">
        {{ ui.icon('trash', 18) }}
    </button>
</div>
