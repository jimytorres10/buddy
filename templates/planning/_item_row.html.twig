{% import '_icons.html.twig' as ui %}
<div class="item-row" data-form-collection-target="item">
    <div class="item-row-fields{{ item.category is defined ? ' has-category' }}">
        <div class="item-field item-field-label">
            {{ form_widget(item.label, {attr: {'aria-label': 'Libellé'}}) }}
            {{ form_errors(item.label) }}
        </div>
        <div class="item-field item-field-amount">
            {{ form_widget(item.amount, {attr: {'aria-label': 'Montant par mois'}}) }}
            {{ form_errors(item.amount) }}
        </div>
        {% if item.category is defined %}
            <div class="item-field item-field-category">
                {{ form_widget(item.category, {attr: {'aria-label': 'Catégorie'}}) }}
            </div>
        {% endif %}
        {% if item.startMonth is defined %}
            {% set has_period = item.startMonth.vars.value or item.endMonth.vars.value or not item.vars.valid %}
            {% set by_duration = item.duration.vars.value is not empty %}
            <details class="item-period"{{ has_period ? ' open' }}
                     data-controller="period"
                     data-period-mode-value="{{ by_duration ? 'duration' : 'dates' }}">
                <summary>{{ ui.icon('calendar', 16) }} Seulement sur une période</summary>
                {% include 'planning/_period_fields.html.twig' with {
                    item: item,
                    hint: item.category is defined
                        ? 'Laisse vide pour « tous les mois ». Ex. : rappel d\'impôts de septembre à décembre.'
                        : 'Laisse vide pour « tous les mois ». Ex. : une prime ce mois-ci, une mission de 6 mois.',
                } only %}
            </details>
        {% endif %}
    </div>
    <button type="button" class="icon-btn icon-btn-danger" data-action="form-collection#remove" aria-label="Retirer cette ligne">
        {{ ui.icon('trash', 18) }}
    </button>
</div>
