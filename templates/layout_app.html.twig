{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block body_class %}with-nav{% endblock %}

{% block body %}
    <main class="page">
        {% include '_flashes.html.twig' %}
        {% block content %}{% endblock %}
    </main>

    {% set route = app.request.attributes.get('_route') %}
    <nav class="bottom-nav" aria-label="Navigation principale">
        <div class="bottom-nav-inner">
            <a href="{{ path('app_dashboard') }}" class="nav-item{{ route == 'app_dashboard' ? ' is-active' }}">
                {{ ui.icon('home', 24) }}<span>Accueil</span>
            </a>
            <a href="{{ path('app_expense_index') }}" class="nav-item{{ route in ['app_expense_index', 'app_expense_edit'] ? ' is-active' }}">
                {{ ui.icon('list', 24) }}<span>Dépenses</span>
            </a>
            <a href="{{ path('app_expense_new') }}" class="nav-item nav-add{{ route == 'app_expense_new' ? ' is-active' }}" aria-label="Ajouter une dépense">
                <span class="nav-add-btn">{{ ui.icon('plus', 26) }}</span>
            </a>
            <a href="{{ path('app_planning') }}" class="nav-item{{ route starts with 'app_planning' or route starts with 'app_category' ? ' is-active' }}">
                {{ ui.icon('pie', 24) }}<span>Budget</span>
            </a>
            <a href="{{ path('app_menu') }}" class="nav-item{{ route starts with 'app_menu' ? ' is-active' }}">
                {{ ui.icon('menu', 24) }}<span>Menu</span>
            </a>
        </div>
    </nav>
{% endblock %}
