{% extends 'layout_app.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}Dépenses · Buddy{% endblock %}
{% block page_class %}page-medium{% endblock %}

{# Après une modification dans la liste, la page est rechargée par morphing : on garde la position. #}
{% block head %}
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
{% endblock %}

{% set filter =currentCategory ? {categorie: currentCategory.id} : {} %}

{% block content %}
    <header class="page-header">
        <h1 class="greeting">Dépenses</h1>
        <div class="header-actions">
            <a href="{{ path('app_import') }}" class="round-btn" aria-label="Importer mes opérations bancaires" title="Importer mes opérations bancaires">{{ ui.icon('upload', 22) }}</a>
            <a href="{{ path('app_expense_new') }}" class="round-btn" aria-label="Ajouter une dépense">{{ ui.icon('plus', 24) }}</a>
        </div>
    </header>

    <div class="month-nav">
        <a href="{{ path('app_expense_index', filter|merge({mois: previous|date('Y-m')})) }}" class="round-btn round-btn-sm" aria-label="Mois précédent">{{ ui.icon('chevron-left', 20) }}</a>
        <div class="month-nav-label">
            <strong>{{ month|month_label }}</strong>
            <span>{{ count }} dépense{{ count > 1 ? 's' }} · {{ total|money }}</span>
        </div>
        {% if isCurrentMonth %}
            <span class="round-btn round-btn-sm is-disabled" aria-hidden="true">{{ ui.icon('chevron-right', 20) }}</span>
        {% else %}
            <a href="{{ path('app_expense_index', filter|merge({mois: next|date('Y-m')})) }}" class="round-btn round-btn-sm" aria-label="Mois suivant">{{ ui.icon('chevron-right', 20) }}</a>
        {% endif %}
    </div>

    <nav class="chips chips-scroll" aria-label="Filtrer par catégorie">
        <a href="{{ path('app_expense_index', {mois: month|date('Y-m')}) }}" class="chip{{ not currentCategory ? ' is-active' }}">Toutes</a>
        {% for category in categories %}
            <a href="{{ path('app_expense_index', {mois: month|date('Y-m'), categorie: category.id}) }}" class="chip{{ currentCategory and currentCategory.id == category.id ? ' is-active' }}">
                <span class="chip-dot tone-{{ category.color }}"></span>{{ category.name }}
            </a>
        {% endfor %}
    </nav>

    {% for day in days %}
        <h2 class="section-title section-title-split">
            <span>{{ day.date|day_label }}</span>
            <span>{{ day.total|money('-') }}</span>
        </h2>
        <div class="card card-body">
            {% for expense in day.items %}
                {% include 'expense/_row.html.twig' %}
            {% endfor %}
        </div>
    {% else %}
        <div class="card empty">
            {{ ui.pill('list', 'teal', 'lg') }}
            <p class="empty-title">Aucune dépense {{ currentCategory ? 'dans « ' ~ currentCategory.name ~ ' » ' }}ce mois-ci</p>
            <a href="{{ path('app_expense_new') }}" class="btn btn-primary">{{ ui.icon('plus', 18) }} Ajouter une dépense</a>
        </div>
    {% endfor %}
{% endblock %}
